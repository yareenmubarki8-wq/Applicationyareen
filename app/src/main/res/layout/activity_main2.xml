<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_blue_gradient"
    android:orientation="vertical"
    tools:context=".ViewPkg.MainActivity2">

    <!-- Top AppBar Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:menu="@menu/main_menu"
        app:title="Travel Dashboard"
        app:titleCentered="false"
        app:titleTextColor="#E0F2FE" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Dashboard Globe Logo -->
            <ImageView
                android:id="@+id/imgMain2Logo"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Travel Dashboard Logo"
                android:scaleType="centerInside"
                android:src="@drawable/ic_main_dashboard_globe" />

            <!-- Welcome User Text -->
            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome!"
                android:textColor="#E0F2FE"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvWelcomeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp"
                android:text="Account active &amp; ready for adventure"
                android:textColor="#38BDF8"
                android:textSize="15sp" />

            <!-- Floating Dark Blue Action Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_blue_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="Your Dashboard"
                    android:textColor="#E0F2FE"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Add New Task Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNewTask2"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="#0284C7"
                    android:text="Add New Task"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_airplane_white"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@android:color/white" />

                <!-- Sign Out Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignOut2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Sign Out"
                    android:textColor="#E0F2FE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="#38BDF8"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
